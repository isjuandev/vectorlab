# Copiar como backend/.env para cambiar valores. Todas las variables usan el prefijo VECTORLAB_.
# Interfaz de escucha: mantener en loopback salvo necesidad explícita.
VECTORLAB_HOST=127.0.0.1
VECTORLAB_PORT=8000
# Carpeta de trabajos (originales, SVG, vistas previas, informes). Por defecto: <repo>/output/jobs
# VECTORLAB_DATA_DIR=/ruta/absoluta
VECTORLAB_MAX_UPLOAD_MB=25
VECTORLAB_MAX_DIMENSION=6000
VECTORLAB_MIN_DIMENSION=8
VECTORLAB_MAX_PIXELS=24000000
# Resolución máxima (en píxeles) a la que se calculan las métricas
VECTORLAB_METRICS_MAX_PIXELS=4000000
VECTORLAB_WORKER_THREADS=1
VECTORLAB_JOB_TTL_HOURS=24
VECTORLAB_MAX_RETAINED_JOBS=50
VECTORLAB_MAX_CANDIDATE_BUDGET=4
# Orígenes CORS permitidos (JSON). Nunca "*".
VECTORLAB_CORS_ORIGINS=["http://localhost:3000","http://127.0.0.1:3000"]
