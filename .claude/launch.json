{
  "version": "0.0.1",
  "configurations": [
    {
      "name": "backend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd backend && exec .venv/bin/python -m app"],
      "port": 8000,
      "url": "http://127.0.0.1:8000"
    },
    {
      "name": "frontend",
      "runtimeExecutable": "bash",
      "runtimeArgs": ["-c", "cd frontend && exec npx next dev --hostname localhost --port 3000"],
      "port": 3000
    }
  ]
}
